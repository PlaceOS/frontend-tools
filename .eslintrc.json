{
    "root": true,
    "ignorePatterns": [
        "**/*"
    ],
    "plugins": [
        "@nx"
    ],
    "overrides": [
        {
            "files": [
                "*.ts",
                "*.tsx",
                "*.js",
                "*.jsx"
            ],
            "rules": {
                "@nx/enforce-module-boundaries": "off",
                "@typescript-eslint/no-inferrable-types": "off",
                "no-prototype-builtins": "off",
                "prefer-const": "off",
                "no-cond-assign": "off",
                "no-var": "off",
                "no-empty": "off"
            }
        },
        {
            "files": [
                "*.ts",
                "*.tsx"
            ],
            "extends": [
                "plugin:@nx/typescript"
            ],
            "rules": {
                "@typescript-eslint/no-inferrable-types": "off",
                "no-prototype-builtins": "off",
                "prefer-const": "off",
                "no-cond-assign": "off",
                "no-var": "off",
                "no-empty": "off"
            }
        },
        {
            "files": [
                "*.js",
                "*.jsx"
            ],
            "extends": [
                "plugin:@nx/javascript"
            ],
            "rules": {}
        }
    ]
}
