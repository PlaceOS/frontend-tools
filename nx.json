        },
        "common": {
            "tags": []
        },
        "components": {
            "tags": []
        },
        "map-regions": {
            "tags": []
        },
        "map-regions-e2e": {
            "tags": [],
            "implicitDependencies": ["map-regions"]
        },
        "sensor-map": {
            "tags": []
        },
        "sensor-map-e2e": {
            "tags": [],
            "implicitDependencies": ["sensor-map"]
        },
        "app-settings": {
            "tags": []
        },
        "app-settings-e2e": {
            "tags": [],
            "implicitDependencies": ["app-settings"]
        }
    }
}
