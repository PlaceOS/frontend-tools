{
    "name": "wayfinding",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/wayfinding/src",
    "prefix": "placeos-tools",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "options": {
                "baseHref": ".",
                "outputPath": "dist/apps/wayfinding",
                "index": "apps/wayfinding/src/index.html",
                "polyfills": ["apps/wayfinding/src/polyfills.ts"],
                "tsConfig": "apps/wayfinding/tsconfig.app.json",
                "assets": [
                    "apps/wayfinding/src/favicon.ico",
                    "apps/wayfinding/src/assets",
                    "apps/wayfinding/src/manifest.webmanifest"
                ],
                "styles": [
                    "apps/sensor-map/src/styles.css",
                    "shared/styles/application.css",
                    "shared/styles/custom-elements.css",
                    "shared/styles/native-elements.css",
                    "./node_modules/@material-design-icons/font/index.css",
                    "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css"
                ],
                "scripts": [],
                "serviceWorker": "apps/wayfinding/ngsw-config.json",
                "browser": "apps/wayfinding/src/main.ts"
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "2mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "2kb",
                            "maximumError": "4kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/wayfinding/src/environments/environment.ts",
                            "with": "apps/wayfinding/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "@angular/build:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "wayfinding:build:production"
                },
                "development": {
                    "buildTarget": "wayfinding:build:development"
                }
            },
            "defaultConfiguration": "development",
            "continuous": true
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "wayfinding:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        }
    }
}
