{
    "name": "map-builder",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/map-builder/src",
    "prefix": "placeos-tools",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "options": {
                "baseHref": "./",
                "outputPath": "dist/apps/map-builder",
                "index": "apps/map-builder/src/index.html",
                "polyfills": ["apps/map-builder/src/polyfills.ts"],
                "tsConfig": "apps/map-builder/tsconfig.app.json",
                "assets": [
                    "apps/map-builder/src/favicon.ico",
                    "apps/map-builder/src/favicon.svg",
                    "apps/map-builder/src/assets",
                    {
                        "glob": "**",
                        "input": "shared/assets",
                        "output": "/assets/"
                    },
                    {
                        "glob": "*.woff2",
                        "input": "node_modules/material-symbols",
                        "output": "/assets/"
                    },
                    "apps/map-builder/src/manifest.webmanifest"
                ],
                "styles": [
                    "apps/map-builder/src/styles.css",
                    "shared/styles/application.css",
                    "shared/styles/custom-elements.css",
                    "shared/styles/native-elements.css"
                ],
                "scripts": [],
                "extractLicenses": false,
                "sourceMap": true,
                "optimization": false,
                "namedChunks": true,
                "browser": "apps/map-builder/src/main.ts"
            },
            "configurations": {
                "staging": {
                    "fileReplacements": [
                        {
                            "replace": "apps/map-builder/src/environments/environment.ts",
                            "with": "apps/map-builder/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "namedChunks": false,
                    "serviceWorker": "apps/map-builder/ngsw-config.json"
                },
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "apps/map-builder/src/environments/environment.ts",
                            "with": "apps/map-builder/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "6kb",
                            "maximumError": "10kb"
                        }
                    ],
                    "serviceWorker": "apps/map-builder/ngsw-config.json"
                }
            },
            "defaultConfiguration": ""
        },
        "serve": {
            "executor": "@angular/build:dev-server",
            "options": {
                "proxyConfig": "config/proxy.conf.js",
                "buildTarget": "map-builder:build"
            },
            "configurations": {
                "production": {
                    "buildTarget": "map-builder:build:production"
                }
            },
            "continuous": true
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "map-builder:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "test": {
            "executor": "@nx/angular:unit-test",
            "outputs": ["{workspaceRoot}/coverage/apps/map-builder"],
            "options": {
                "tsConfig": "apps/map-builder/tsconfig.spec.json",
                "watch": false
            },
            "configurations": {
                "ci": {
                    "coverage": true
                }
            }
        }
    }
}
