{
    "version": 1,
    "projects": {
        "app-settings": {
            "projectType": "application",
            "root": "apps/app-settings",
            "sourceRoot": "apps/app-settings/src",
            "prefix": "placeos-tools",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:browser",
                    "outputs": ["{options.outputPath}"],
                    "options": {
                        "baseHref": ".",
                        "outputPath": "dist/apps/app-settings",
                        "index": "apps/app-settings/src/index.html",
                        "main": "apps/app-settings/src/main.ts",
                        "polyfills": "apps/app-settings/src/polyfills.ts",
                        "tsConfig": "apps/app-settings/tsconfig.app.json",
                        "assets": [
                            "apps/app-settings/src/favicon.ico",
                            "apps/app-settings/src/assets",
                            "apps/app-settings/src/manifest.webmanifest"
                        ],
                        "styles": [
                            "apps/app-settings/src/styles.css",
                            "shared/styles/application.scss",
                            "shared/styles/custom-elements.scss",
                            "shared/styles/native-elements.scss",
                            "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css"
                        ],
                        "scripts": [],
                        "serviceWorker": true,
                        "ngswConfigPath": "apps/app-settings/ngsw-config.json"
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kb",
                                    "maximumError": "1mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "2kb",
                                    "maximumError": "4kb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "apps/app-settings/src/environments/environment.ts",
                                    "with": "apps/app-settings/src/environments/environment.prod.ts"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "buildOptimizer": false,
                            "optimization": false,
                            "vendorChunk": true,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "namedChunks": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "configurations": {
                        "production": {
                            "browserTarget": "app-settings:build:production"
                        },
                        "development": {
                            "browserTarget": "app-settings:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "browserTarget": "app-settings:build"
                    }
                },
                "lint": {
                    "builder": "@nrwl/linter:eslint",
                    "options": {
                        "lintFilePatterns": [
                            "apps/app-settings/src/**/*.ts",
                            "apps/app-settings/src/**/*.html"
                        ]
                    },
                    "outputs": ["{options.outputFile}"]
                },
                "test": {
                    "builder": "@nrwl/jest:jest",
                    "outputs": ["coverage/apps/app-settings"],
                    "options": {
                        "jestConfig": "apps/app-settings/jest.config.ts",
                        "passWithNoTests": true
                    }
                }
            },
            "tags": []
        },
        "app-settings-e2e": {
            "root": "apps/app-settings-e2e",
            "sourceRoot": "apps/app-settings-e2e/src",
            "projectType": "application",
            "architect": {
                "e2e": {
                    "builder": "@nrwl/cypress:cypress",
                    "options": {
                        "cypressConfig": "apps/app-settings-e2e/cypress.json",
                        "tsConfig": "apps/app-settings-e2e/tsconfig.e2e.json",
                        "devServerTarget": "app-settings:serve:development"
                    },
                    "configurations": {
                        "production": {
                            "devServerTarget": "app-settings:serve:production"
                        }
                    }
                },
                "lint": {
